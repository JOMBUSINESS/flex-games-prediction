PORT=3000
NODE_ENV=development

DATABASE_URL=your_postgresql_connection_string
SESSION_SECRET=replace_with_a_long_random_secret
REQUIRE_PHONE_VERIFICATION=true

# Comma-separated exact origins for the public website and admin website.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
PUBLIC_APP_URL=http://localhost:5500

# Resend password recovery email configuration
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=FLEX GAMES <no-reply@your-verified-domain.com>

# One-time initial super-admin bootstrap values
ADMIN_EMAIL=admin@example.com
ADMIN_PHONE=+233XXXXXXXXX
ADMIN_PASSWORD=use-a-long-unique-password
ADMIN_NAME=FLEX Super Admin
